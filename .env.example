# ============================================================================
# TEC THA Follow-Up Engine — environment configuration
# Copy to .env (Docker) or backend/.env (running the API directly) and fill in.
# Never commit real values. Generate secrets with the commands shown.
# ============================================================================

# ---- General ------------------------------------------------------------------
ENVIRONMENT=production            # development | test | production
DOMAIN=followup.example.in        # public hostname served by Caddy (HTTPS is automatic)
PUBLIC_APP_URL=https://followup.example.in   # used in booking/reschedule links and reset emails

# ---- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=tectha
POSTGRES_USER=tectha
POSTGRES_PASSWORD=change-me-long-random   # openssl rand -base64 24
# Set automatically by docker-compose. For running the API directly use e.g.:
# DATABASE_URL=postgresql+psycopg://tectha:PASSWORD@localhost:5432/tectha
# Local single-laptop demo only:  DATABASE_URL=sqlite:///./tectha-demo.db
BACKUP_KEEP_DAYS=14

# ---- Security -------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts WhatsApp access tokens at rest. Keep a safe copy: losing it means re-entering tokens.
ENCRYPTION_KEY=
COOKIE_SECURE=true                # must be true in production (HTTPS)
ACCESS_TOKEN_MINUTES=720          # staff session length (12h shift)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=                     # leave empty: the UI calls the API on the same origin

# ---- WhatsApp Business Platform (Cloud API) ------------------------------------
# Per-hospital phone number ID / WABA ID / access token are entered in the app (Settings → WhatsApp)
# and stored encrypted. These platform values come from your Meta app (developers.facebook.com):
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=            # any random string; paste the same value in Meta → Webhooks → Verify token
META_APP_SECRET=                  # Meta App → Settings → Basic → App secret (validates webhook signatures)
WHATSAPP_HTTP_TIMEOUT_SECONDS=15

# ---- Reminder engine --------------------------------------------------------------
REMINDER_MAX_ATTEMPTS=3
WORKER_INTERVAL_SECONDS=30
RUN_WORKER_IN_API=false           # true only for single-process local runs; Docker runs a separate worker
QUIET_HOURS_START=21              # catch-up reminders are never sent 21:00–08:00 local time
QUIET_HOURS_END=8
FOLLOWUP_RED_DAYS=2               # unconfirmed follow-ups turn red this many days before the date

# ---- Email (password reset) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@followup.example.in
SMTP_STARTTLS=true

# ---- Demo deployment ONLY (never on a real hospital deployment) ---------------------
DEMO_MODE=false                   # enables demo clock + simulator controls for the demo hospital
DEMO_PASSWORD=                    # password for admin@ / staff@ / platform@tectha-demo.in (seed script)
DEMO_ANCHOR_DATE=2026-11-09       # the Monday the Mr. Ravi scenario starts on
